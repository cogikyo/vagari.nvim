{
  "$schema": "https://example.com/config.schema.json",
  "project": {
    "name": "vagari",
    "version": "0.4.0",
    "description": "A Neovim colorscheme with\ttabs and \"quoted\" strings",
    "license": "MIT",
    "private": false
  },
  "build": {
    "target": "es2022",
    "outDir": "./dist",
    "sourcemap": true,
    "minify": false,
    "entry": ["src/index.ts", "src/cli.ts"],
    "external": ["react", "react-dom"],
    "define": {
      "process.env.NODE_ENV": "\"production\"",
      "__VERSION__": "\"0.4.0\""
    }
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "cors": {
      "origins": ["http://localhost:3000", "https://example.com"],
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "credentials": true,
      "maxAge": 86400
    },
    "rateLimit": {
      "windowMs": 900000,
      "max": 100,
      "standardHeaders": true
    }
  },
  "database": {
    "url": "postgresql://user:pass@localhost:5432/vagari",
    "pool": {
      "min": 2,
      "max": 10,
      "idleTimeoutMs": 30000
    },
    "migrations": {
      "directory": "./migrations",
      "tableName": "schema_migrations"
    }
  },
  "features": {
    "darkMode": true,
    "analytics": false,
    "experimental": {
      "newEditor": true,
      "aiAssist": false,
      "maxTokens": 4096,
      "temperature": 0.7
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run --coverage",
    "lint": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "tags": ["colorscheme", "neovim", "theme", "syntax-highlighting"],
  "contributors": [
    { "name": "Alice", "email": "alice@example.com", "role": "maintainer" },
    { "name": "Bob", "email": null, "role": "contributor" }
  ]
}
